# =========================================================
# CLEAN DOMAIN INPUT
# =========================================================

def clean_domain(domain):

    domain = domain.strip()

    domain = re.sub(
        r'^\[.*?\]\s*',
        '',
        domain
    )

    domain = re.sub(r'^https?://', '', domain)
    domain = re.sub(r'/.*$', '', domain)
    domain = re.sub(r':\d+$', '', domain)

    return domain.strip().lower()


# =========================================================
# DNS FUNCTIONS
# =========================================================

def resolve_cname(domain):

    try:

        resolver = dns.resolver.Resolver()

        resolver.timeout = 5
        resolver.lifetime = 5

        answers = resolver.resolve(
            domain,
            "CNAME"
        )

        return [
            str(r.target).rstrip(".")
            for r in answers
        ]

    except dns.resolver.NoAnswer:
        return []

    except dns.resolver.NXDOMAIN:
        return None

    except Exception:
        return []


def check_target_exists(target):

    try:

        socket.gethostbyname(target)

        return True

    except socket.gaierror:
        return False

    except Exception:
        return None


def verify_dead_target(target):

    # Rapid initial check
    if check_target_exists(target) is not False:
        return False

    # Short confirmation retry to filter transient network glitches
    time.sleep(0.3)
    return check_target_exists(target) is False


# =========================================================
# SSL CHECK
# =========================================================

def check_ssl(domain):

    try:

        ssl.get_server_certificate(
            (domain, 443)
        )

        return True

    except Exception:
        return False


# =========================================================
# DIG VALIDATION
# =========================================================

def run_dig(domain):

    try:

        result = subprocess.run(
            ["dig", domain, "CNAME"],
            capture_output=True,
            text=True
        )

        return result.stdout

    except Exception:
        return None


# =========================================================
# HTTP FUNCTIONS
# =========================================================

def fetch_http(domain):

    results = {}

    for proto in ["https", "http"]:

        url = f"{proto}://{domain}"

        try:

            response = requests.get(
                url,
                timeout=10,
                verify=False,
                allow_redirects=False,
                headers=HEADERS
            )

            results[proto] = {
                "status_code":
                response.status_code,

                "headers":
                dict(response.headers),

                "body":
                response.text[:3000]
            }

        except Exception as e:

            results[proto] = {
                "error": str(e)
            }

    return results


# =========================================================
# SERVICE DETECTION
# =========================================================

def detect_service(cname_target):

    for service, config in SERVICES.items():

        for pattern in config["patterns"]:

            if re.search(
                pattern,
                cname_target.lower()
            ):

                return service

    return None


# =========================================================
# FALSE POSITIVE FILTER
# =========================================================

def contains_false_positive(body):

    body = body.lower()

    return any(
        fp in body
        for fp in GENERIC_FALSE_POSITIVES
    )


# =========================================================
# HTTP VALIDATION
# =========================================================

def validate_http(service, responses):

    config = SERVICES[service]

    for proto, resp in responses.items():

        if "status_code" not in resp:
            continue

        body = resp.get(
            "body",
            ""
        ).lower()

        headers = {
            k.lower(): v
            for k, v in resp.get(
                "headers", {}
            ).items()
        }

        if contains_false_positive(body):
            return False

        status_match = (
            resp["status_code"]
            in config["status_codes"]
        )

        keyword_match = any(
            kw.lower() in body
            for kw in config["keywords"]
        )

        header_match = True

        if config.get("headers"):

            header_match = any(
                h.lower() in headers
                for h in config["headers"]
            )

        if (
            status_match and
            keyword_match and
            header_match
        ):
            return True

    return False


# =========================================================
# CLAIMABILITY CHECK
# =========================================================

def is_claimable(service):

    return service not in NON_CLAIMABLE


# =========================================================
# MAIN CHECK
# =========================================================

def check_subdomain(domain):

    result = {
        "domain": domain,
        "vulnerable": False,
        "takeoverable": False,
        "service": None,
        "details": {}
    }

    domain = clean_domain(domain)

    cname_records = resolve_cname(domain)

    if cname_records is None:

        result["details"]["reason"] = (
            "NXDOMAIN"
        )

        return result

    if not cname_records:
        # Fallback to dig subprocess if dnspython had no answers
        dig_out = run_dig(domain)
        if dig_out:
            for line in dig_out.splitlines():
                if "CNAME" in line and not line.startswith(";"):
                    parts = line.strip().split()
                    if len(parts) >= 5:
                        cname_records = [parts[-1].rstrip(".")]
                        result["details"]["dig_fallback"] = True
                        break

    if not cname_records:

        result["details"]["reason"] = (
            "No CNAME"
        )

        return result

    cname_target = cname_records[0]

    result["details"]["cname"] = (
        cname_target
    )

    service = detect_service(
        cname_target
    )

    if not service:

        result["details"]["reason"] = (
            "Unknown provider"
        )

        return result

    result["service"] = service

    ssl_valid = check_ssl(domain)

    result["details"]["ssl"] = (
        ssl_valid
    )

    dead_target = verify_dead_target(
        cname_target
    )

    result["details"]["dead_target"] = (
        dead_target
    )

    responses = fetch_http(domain)

    result["details"]["http_checked"] = (
        True
    )

    valid_http = validate_http(
        service,
        responses
    )

    claimable = is_claimable(service)

    result["details"]["claimable"] = (
        claimable
    )

    if (
        dead_target and
        valid_http and
        claimable
    ):

        result["vulnerable"] = True

        result["takeoverable"] = True

        result["details"]["reason"] = (
            "Strict fingerprint match"
        )

    elif dead_target:

        result["vulnerable"] = True

        result["takeoverable"] = False

        result["details"]["reason"] = (
            "Dead DNS only"
        )

    return result


# =========================================================
# SCANNER
# =========================================================

def scan_domains(domains, threads=10):

    results = []

    with ThreadPoolExecutor(
        max_workers=threads
    ) as executor:

        futures = {
            executor.submit(
                check_subdomain,
                d
            ): d
            for d in domains
        }

        for future in as_completed(futures):

            domain = futures[future]

            try:

                result = future.result()

                results.append(result)

                if result["takeoverable"]:

                    print(
                        f"{RED}{BOLD}[CRITICAL]{RESET} "
                        f"{domain} "
                        f"-> "
                        f"{CYAN}{result['service']}{RESET}"
                    )

                elif result["vulnerable"]:

                    print(
                        f"{YELLOW}[WARNING]{RESET} "
                        f"{domain}"
                    )

                else:

                    print(
                        f"{GREEN}[SAFE]{RESET} "
                        f"{domain}"
                    )

            except Exception as e:

                print(
                    f"{RED}[ERROR]{RESET} "
                    f"{domain}: {e}"
                )

    return results


# =========================================================
# SUMMARY
# =========================================================

def print_summary(results):

    critical = [
        r for r in results
        if r["takeoverable"]
    ]

    warnings = [
        r for r in results
        if (
            r["vulnerable"]
            and not r["takeoverable"]
        )
    ]

    print("\n" + "=" * 60)

    print(
        f"{BLUE}{BOLD}"
        f"SCAN SUMMARY"
        f"{RESET}"
    )

    print("=" * 60)

    print(f"Critical : {len(critical)}")
    print(f"Warnings : {len(warnings)}")
    print(f"Total    : {len(results)}")

    print("=" * 60)

    if critical:

        print(
            f"\n{RED}{BOLD}"
            f"[CRITICAL FINDINGS]"
            f"{RESET}\n"
        )

        for r in critical:

            print(
                f"Domain : {r['domain']}"
            )

            print(
                f"Service: {r['service']}"
            )

            print(
                f"CNAME  : "
                f"{r['details'].get('cname')}"
            )

            print()


# =========================================================
# SAVE JSON
# =========================================================

def save_json(results, filename):

    with open(filename, "w") as f:

        json.dump(
            results,
            f,
            indent=2
        )

    print(
        f"\n{CYAN}[+] Saved -> "
        f"{filename}{RESET}"
    )


