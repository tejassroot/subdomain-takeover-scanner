    )

    parser.add_argument(
        "-f",
        "--file",
        help="File with domains"
    )

    parser.add_argument(
        "-t",
        "--threads",
        type=int,
        default=10
    )

    parser.add_argument(
        "-o",
        "--output",
        help="Output JSON file"
    )

    args = parser.parse_args()

    domains = []

    if args.domain:

        domains = [args.domain]

    elif args.file:

        with open(args.file, "r") as f:

            domains = [
                clean_domain(line)
                for line in f
                if line.strip()
            ]

    else:

        print("Use -d or -f")

        sys.exit(1)

    print(
        f"\n{CYAN}{BOLD}[+] Starting scan "
        f"against {len(domains)} "
        f"domains...{RESET}\n"
    )

    results = scan_domains(
        domains,
        threads=args.threads
    )

    print_summary(results)

    if args.output:

        save_json(
            results,
            args.output
        )
